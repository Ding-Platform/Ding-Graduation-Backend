// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String?
  image         String?
  password      String?
  emailVerified Boolean  @default(false)
  active        Boolean  @default(true)
  isBanned      Boolean  @default(false)
  banReason     String?
  role          UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Session           Session[]
  Otp               Otp[]
  Profile           Profile?
  Notification      Notification[]
  NotificationActor Notification[] @relation("NotificationActor")
  Post              Post[]
  Likes             Like[]
  Comments          Comment[]
  savedPosts        SavedPost[]

  // Social Graph Relations
  sentFriendRequests     Friendship[] @relation("SentFriendRequests")
  receivedFriendRequests Friendship[] @relation("ReceivedFriendRequests")

  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")

  blockedUsers Block[] @relation("BlockedUsers")
  blockedBy    Block[] @relation("BlockedBy")

  // Messaging Relations
  messages         Message[]
  roomMemberships  RoomMember[]
  createdRooms     Room[]            @relation("RoomCreator")
  messageReactions MessageReaction[]
  readReceipts     ReadReceipt[]

  // Marketplace & Moderation & AI
  products           Product[]
  transactions       Transaction[]    @relation("BuyerTransactions")
  sales              Transaction[]    @relation("SellerTransactions")
  reports            Report[]         @relation("Reporter")
  noroChats          NoroChat[]
  sellerApplication  SellerApplication?
  sellerProfile      SellerProfile?
  adminDealLogs      DealLog[]        @relation("AdminDealLogs")
  callRoomsCreated   CallRoom[]       @relation("CallRoomCreator")
  callParticipants   CallParticipant[]
  noroConversations  NoroConversation[]
  noroMessages       NoroMessage[]
  userMoodProfile    UserMoodProfile?
  crisisEvents       CrisisEvent[]
  emergencyContacts  UserEmergencyContact[]
  reels              Reel[]
  reelViews          ReelView[]
  reelLikes          ReelLike[]
  reelComments       ReelComment[]
  reelShares         ReelShare[]

  // Sprint 12 — Stories
  stories            Story[]
  storyViews         StoryView[]

  // Sprint 13 — Social Groups
  ownedGroups        Group[]       @relation("GroupCreator")
  groupMemberships   GroupMember[]
  groupJoinRequests  GroupJoinRequest[]

  // Sprint 14 — Pages
  ownedPages         Page[]        @relation("PageCreator")
  pageRoles          PageMember[]

  // Sprint 18 — Live Streaming
  hostedStreams      LiveStream[]  @relation("StreamHost")

  // Sprint 19 — Analytics
  analyticsEvents    AnalyticsEvent[]

  // Sprint 20 — Events
  hostedEvents       Event[]       @relation("EventHost")
  eventRsvps         EventAttendee[]
  eventTickets       EventTicket[]
  eventReminders     EventReminder[]
}

model Session {
  id           String        @id @default(uuid())
  status       SessionStatus @default(ACTIVE)
  refreshToken String?

  ipAddress String?
  userAgent String?

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SessionStatus {
  ACTIVE
  INACTIVE
}

model Otp {
  id           String   @id @default(uuid())
  otpHash      String
  otpExpiresAt DateTime
  otpVerified  Boolean  @default(false)

  type   OtpType
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([otpExpiresAt])
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio         String?   @db.Text
  coverPhoto  String?
  dateOfBirth DateTime?
  location    String?
  website     String?
  phoneNumber String?

  // Privacy settings
  privacySettings ProfilePrivacy?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ProfilePrivacy {
  id        String  @id @default(uuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  // Who can see profile information
  profileVisibility     VisibilityType @default(FRIENDS)
  postsVisibility       VisibilityType @default(FRIENDS)
  friendsVisibility     VisibilityType @default(FRIENDS)
  bioVisibility         VisibilityType @default(FRIENDS)
  emailVisibility       VisibilityType @default(PRIVATE)
  phoneVisibility       VisibilityType @default(PRIVATE)
  locationVisibility    VisibilityType @default(FRIENDS)
  dateOfBirthVisibility VisibilityType @default(FRIENDS)

  // Who can interact
  whoCanSendFriendRequests VisibilityType @default(EVERYONE)
  whoCanMessageMe          VisibilityType @default(FRIENDS)

  // Media permissions
  allowCameraAccess     Boolean @default(false)
  allowMicrophoneAccess Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

enum VisibilityType {
  PUBLIC
  FRIENDS
  FRIENDS_OF_FRIENDS
  ONLY_ME
  PRIVATE
  EVERYONE
  CUSTOM
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_REQUEST_ACCEPTED
  NEW_FOLLOWER
  POST_LIKE
  POST_COMMENT
  COMMENT_LIKE
  MENTION
  SYSTEM
  // Sprint 12
  STORY_REACTION
  // Sprint 13
  GROUP_INVITE
  GROUP_JOIN
  GROUP_JOIN_REQUEST
  GROUP_JOIN_APPROVED
  // Sprint 18
  LIVE_STARTED
  // Sprint 20
  EVENT_INVITE
  EVENT_REMINDER
  EVENT_RSVP
}

model Notification {
  id      String           @id @default(uuid())
  type    NotificationType
  title   String
  message String
  read    Boolean          @default(false)
  data    Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model Post {
  id       String @id @default(uuid())
  content  String @db.Text
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  mediaUrls String[]    @default([])
  privacy   PostPrivacy @default(PUBLIC)

  // Soft delete fields
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likeCount    Int       @default(0)
  commentCount Int       @default(0)

  // Relations
  PostHistory  PostHistory[]
  PostMedia    PostMedia[]
  PostAudience PostAudience[]
  Likes        Like[]
  Comments     Comment[]
  savedBy      SavedPost[]
  groupPosts   GroupPost[]
  pagePosts    PagePost[]

  @@index([authorId])
  @@index([isDeleted])
  @@index([createdAt])
  @@index([authorId, isDeleted])
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  commentId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId], map: "Like_userId_postId_key")
  @@unique([userId, commentId], map: "Like_userId_commentId_key")
  @@index([postId])
  @@index([commentId], map: "Like_commentId_idx")
}

model Comment {
  id              String    @id @default(uuid())
  content         String
  postId          String
  authorId        String
  parentId        String?   @map("parentCommentId")
  likeCount       Int       @default(0)
  replyCount      Int       @default(0)
  post            Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author          User      @relation(fields: [authorId], references: [id])
  parent          Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade, map: "Comment_parentCommentId_fkey")
  replies         Comment[] @relation("CommentReplies")
  likes           Like[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@index([postId])
  @@index([authorId])
  @@index([parentId], map: "Comment_parentCommentId_idx")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Friendship {
  id          String           @id @default(uuid())
  requester   User             @relation("SentFriendRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String
  recipient   User             @relation("ReceivedFriendRequests", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, recipientId])
  @@index([requesterId])
  @@index([recipientId])
}

model Follow {
  id          String   @id @default(uuid())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followerId  String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Block {
  id        String   @id @default(uuid())
  blocker   User     @relation("BlockedUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model PostHistory {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  content   String      @db.Text
  mediaUrls String[]    @default([])
  privacy   PostPrivacy

  changeType PostChangeType
  changedAt  DateTime       @default(now())

  @@index([postId])
  @@index([changedAt])
}

enum PostChangeType {
  CREATED
  UPDATED
  DELETED
  RESTORED
}

model PostMedia {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  url      String
  type     MediaType
  publicId String // Cloudinary public ID for deletion
  size     Int // File size in bytes
  width    Int?
  height   Int?

  createdAt DateTime @default(now())

  @@index([postId])
}

enum MediaType {
  IMAGE
  VIDEO
}

model PostAudience {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

enum PostPrivacy {
  PUBLIC
  FRIENDS
  FRIENDS_OF_FRIENDS
  ONLY_ME
  CUSTOM
}

model Message {
  id      String @id @default(uuid())
  content String @db.Text

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // Reply/Threading support
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  // Message metadata
  isEdited        Boolean @default(false)
  isForwarded     Boolean @default(false)
  forwardedFromId String?

  // Soft delete
  deletedAt          DateTime?
  deletedForEveryone Boolean   @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  reactions    MessageReaction[]
  readReceipts ReadReceipt[]
  media        MessageMedia[]
  editHistory  MessageEditHistory[]
  pinnedIn     PinnedMessage[]

  @@index([userId])
  @@index([roomId])
  @@index([replyToId])
  @@index([createdAt])
}

model MessageReaction {
  id    String @id @default(uuid())
  emoji String // Store emoji as unicode string

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji]) // One reaction type per user per message
  @@index([messageId])
  @@index([userId])
}

model ReadReceipt {
  id String @id @default(uuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}

model MessageMedia {
  id String @id @default(uuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  url  String
  type MessageMediaType

  // File metadata
  fileName String?
  fileSize Int? // Size in bytes
  mimeType String?

  // Media-specific metadata
  width     Int?
  height    Int?
  duration  Int? // Duration in seconds for audio/video
  thumbnail String? // Thumbnail URL for videos

  // Cloud storage metadata
  publicId String? // Cloudinary/S3 public ID

  createdAt DateTime @default(now())

  @@index([messageId])
}

enum MessageMediaType {
  IMAGE
  VIDEO
  AUDIO
  VOICE_NOTE
  DOCUMENT
  FILE
}

model MessageEditHistory {
  id String @id @default(uuid())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  content  String   @db.Text
  editedAt DateTime @default(now())

  @@index([messageId])
  @@index([editedAt])
}

model Room {
  id   String   @id @default(uuid())
  type RoomType @default(DIRECT)

  // Group chat metadata
  name        String?
  description String? @db.Text
  imageUrl    String?

  // Creator tracking
  createdById String?
  createdBy   User?   @relation("RoomCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // Activity tracking
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  messages       Message[]
  members        RoomMember[]
  pinnedMessages PinnedMessage[]

  @@index([type])
  @@index([lastMessageAt])
  @@index([createdById])
}

enum RoomType {
  DIRECT // One-on-one chat
  GROUP // Group chat
  CHANNEL // Broadcast channel (optional for future)
}

model RoomMember {
  id String @id @default(uuid())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Member role and permissions
  role RoomMemberRole @default(MEMBER)

  // User-specific room settings
  isMuted    Boolean @default(false)
  isArchived Boolean @default(false)

  // Tracking
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  // Last read message for unread count
  lastReadMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@index([role])
}

enum RoomMemberRole {
  ADMIN
  MODERATOR
  MEMBER
}

model PinnedMessage {
  id String @id @default(uuid())

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  pinnedAt DateTime @default(now())

  @@unique([roomId, messageId])
  @@index([roomId])
  @@index([messageId])
}

model SavedPost {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([postId])
}

// Enums
enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  NUDITY
  VIOLENCE
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  RESOLVED
}

enum ProductStatus {
  ACTIVE
  SOLD
  INACTIVE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum ReportTargetType {
  USER
  POST
  COMMENT
}

// New Models
model Product {
  id          String        @id @default(uuid())
  title       String
  description String        @db.Text
  price       Float
  currency    String        @default("USD")
  images      String[]      @default([])
  categoryId  String?
  status      ProductStatus @default(ACTIVE)
  quantity    Int           @default(1)

  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
}

model Transaction {
  id       String            @id @default(uuid())
  amount   Float
  currency String
  status   TransactionStatus @default(PENDING)

  buyerId String
  buyer   User   @relation("BuyerTransactions", fields: [buyerId], references: [id])

  sellerId String
  seller   User   @relation("SellerTransactions", fields: [sellerId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([productId])
}

model Report {
  id          String           @id @default(uuid())
  targetId    String
  targetType  ReportTargetType
  reason      ReportReason
  description String?          @db.Text
  status      ReportStatus     @default(PENDING)
  actionTaken String?
  
  reporterId  String
  reporter    User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reporterId])
  @@index([status])
}

model NoroChat {
  id        String   @id @default(uuid())
  message   String   @db.Text
  response  String   @db.Text
  
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model CallRoom {
  id              String            @id
  createdById     String?
  createdBy       User?             @relation("CallRoomCreator", fields: [createdById], references: [id], onDelete: SetNull)
  endedAt         DateTime?
  maxParticipants Int               @default(16)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  participants    CallParticipant[]

  @@index([createdById])
}

model CallParticipant {
  id          String    @id @default(uuid())
  roomId      String
  room        CallRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  peerId      String
  isAudioOn   Boolean   @default(true)
  isVideoOn   Boolean   @default(true)
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([roomId, leftAt])
  @@index([userId, roomId])
  @@index([peerId])
}

model NoroConversation {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger    NoroTrigger?
  moodScore  Int?
  startedAt  DateTime      @default(now())
  endedAt    DateTime?
  deletedAt  DateTime?
  messages   NoroMessage[]
  moodSource UserMoodProfile[] @relation("MoodSourceConversation")

  @@index([userId, startedAt])
  @@index([deletedAt])
}

model NoroMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   NoroConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           NoroMessageRole
  content        String           @db.Text
  sentiment      Json?
  keywords       String[]         @default([])
  createdAt      DateTime         @default(now())
  deletedAt      DateTime?
  crisisEvents   CrisisEvent[]

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
  @@index([deletedAt])
}

model UserMoodProfile {
  userId        String            @id
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  moodScore     Decimal?          @db.Decimal(4, 2)
  dominantMood  String?
  energyLevel   Decimal?          @db.Decimal(4, 2)
  lastUpdated   DateTime          @default(now())
  sourceConvId  String?
  sourceConv    NoroConversation? @relation("MoodSourceConversation", fields: [sourceConvId], references: [id], onDelete: SetNull)

  @@index([lastUpdated])
  @@index([sourceConvId])
}

model CrisisEvent {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId    String?
  message      NoroMessage?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  crisisScore  Decimal              @db.Decimal(5, 4)
  severity     CrisisSeverity
  intervention CrisisIntervention?
  keywordsHit  String[]             @default([])
  resolvedAt   DateTime?
  createdAt    DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([severity, createdAt])
}

model CrisisHotline {
  id          String   @id @default(uuid())
  countryCode String   @db.Char(2)
  name        String
  phone       String?
  sms         String?
  chatUrl     String?
  language    String   @default("en")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([countryCode, language, isActive])
}

model UserEmergencyContact {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactName    String
  contactPhone   String?
  contactEmail   String?
  notifyOnCrisis Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model Reel {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoUrl      String?
  rawVideoKey   String?
  thumbnailUrl  String?
  caption       String?     @db.Text
  audioTrackId  String?
  audioTrack    AudioTrack? @relation(fields: [audioTrackId], references: [id], onDelete: SetNull)
  audioOffsetMs Int         @default(0)
  durationSec   Int?
  width         Int?
  height        Int?
  fileSizeBytes BigInt?
  status        ReelStatus  @default(PENDING)
  failReason    String?
  viewsCount    BigInt      @default(0)
  likesCount    BigInt      @default(0)
  commentsCount BigInt      @default(0)
  sharesCount   BigInt      @default(0)
  hashtags      String[]    @default([])
  isPublic      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  views         ReelView[]
  likes         ReelLike[]
  comments      ReelComment[]
  shares        ReelShare[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([isPublic, status, createdAt])
  @@index([audioTrackId])
}

model AudioTrack {
  id           String   @id @default(uuid())
  title        String
  artist       String?
  durationSec  Int
  audioUrl     String
  waveformData Json?
  genre        String?
  isLicensed   Boolean  @default(false)
  usageCount   BigInt   @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reels        Reel[]

  @@index([usageCount])
  @@index([genre])
}

model ReelView {
  id        String   @id @default(uuid())
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  viewerId  String?
  viewer    User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  viewedAt  DateTime @default(now())
  watchPct  Int?
  sessionId String?

  @@index([reelId, viewedAt])
  @@index([viewerId, viewedAt])
  @@index([sessionId, reelId])
}

model ReelLike {
  reelId    String
  reel      Reel     @relation(fields: [reelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([reelId, userId])
  @@index([userId, createdAt])
}

model ReelComment {
  id         String        @id @default(uuid())
  reelId     String
  reel       Reel          @relation(fields: [reelId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     ReelComment?  @relation("ReelCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    ReelComment[] @relation("ReelCommentReplies")
  content    String        @db.Text
  likesCount Int           @default(0)
  createdAt  DateTime      @default(now())
  deletedAt  DateTime?

  @@index([reelId, createdAt])
  @@index([parentId, createdAt])
  @@index([deletedAt])
}

model ReelShare {
  id        String    @id @default(uuid())
  reelId    String
  reel      Reel      @relation(fields: [reelId], references: [id], onDelete: Cascade)
  sharerId  String
  sharer    User      @relation(fields: [sharerId], references: [id], onDelete: Cascade)
  shareType ShareType
  targetId  String?
  createdAt DateTime  @default(now())

  @@index([reelId, createdAt])
  @@index([sharerId, createdAt])
}

// ─────────────────────────────────────────────
// Marketplace: Roles, Seller KYC & Admin Audit
// ─────────────────────────────────────────────

enum UserRole {
  USER
  SELLER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DECLINED
}

enum DealLogTargetType {
  SELLER
  TRANSACTION
}

enum DealLogAction {
  BAN_SELLER
  UNBAN_SELLER
  SUSPEND_SELLER
  UNSUSPEND_SELLER
  CANCEL_DEAL
  APPROVE_APPLICATION
  DECLINE_APPLICATION
}

enum NoroTrigger {
  USER_INITIATED
  PERIODIC_CHECKIN
  CRISIS_ALERT
}

enum NoroMessageRole {
  USER
  ASSISTANT
}

enum CrisisSeverity {
  LOW
  MEDIUM
  HIGH
}

enum CrisisIntervention {
  NONE
  SOFT
  HOTLINE
  ESCALATED
}

enum ReelStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ShareType {
  STORY
  FEED
  EXTERNAL
  DM
}

/// Full KYC application submitted by a user requesting Seller status
model SellerApplication {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal info
  fullName    String
  phoneNumber String
  email       String
  address     String
  city        String
  country     String

  // Identity verification (images stored on Cloudinary)
  idCardNumber     String // AES-256 encrypted
  idCardFrontImage String // Cloudinary URL
  idCardBackImage  String // Cloudinary URL
  sellerFaceImage  String // Cloudinary URL

  // Business info
  commercialRegNumber String // رقم السجل التجاري — AES-256 encrypted
  bankAccountNumber   String // AES-256 encrypted
  bankCardNumber      String // AES-256 encrypted, Luhn-validated
  bankCardExpiry      String // MM/YY
  bankCardHolderName  String

  // Address trust scoring (derived from session IP history)
  addressTrustScore Float   @default(0)
  addressVerified   Boolean @default(false)
  sessionCount      Int     @default(0) // total sessions at application time
  uniqueIpCount     Int     @default(0) // unique IPs seen

  // Review
  status       ApplicationStatus @default(PENDING)
  adminNote    String?           @db.Text
  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/// Extended profile created when a SellerApplication is approved
model SellerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName        String?
  phoneNumber         String
  address             String
  city                String
  country             String
  commercialRegNumber String // AES-256 encrypted
  bankAccountNumber   String // AES-256 encrypted
  bankCardLast4       String // last 4 digits only (safe to store plain)

  isSuspended   Boolean  @default(false)
  isBanned      Boolean  @default(false)
  suspendReason String?
  banReason     String?
  suspendedAt   DateTime?
  bannedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isBanned])
  @@index([isSuspended])
}

/// Admin audit trail for every action taken on sellers or deals
model DealLog {
  id       String @id @default(uuid())
  adminId  String
  admin    User   @relation("AdminDealLogs", fields: [adminId], references: [id])

  targetType DealLogTargetType
  targetId   String // sellerId or transactionId

  action DealLogAction
  cause  String?       @db.Text

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([targetId])
  @@index([targetType, createdAt])
}

// ─────────────────────────────────────────────
// Sprint 12: Stories
// ─────────────────────────────────────────────

enum StoryPrivacy {
  PUBLIC
  FRIENDS
  CLOSE_FRIENDS
}

model Story {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  mediaUrl     String
  thumbnailUrl String?
  caption      String?      @db.Text
  privacy      StoryPrivacy @default(FRIENDS)
  isHighlight  Boolean      @default(false)

  viewsCount   Int          @default(0)
  expiresAt    DateTime     // Set to createdAt + 24h; null means highlight (no expiry)

  createdAt    DateTime     @default(now())
  deletedAt    DateTime?

  views        StoryView[]

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([privacy, expiresAt])
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerId  String
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([storyId, viewerId])
  @@index([storyId, viewedAt])
  @@index([viewerId])
}

// ─────────────────────────────────────────────
// Sprint 13: Social Groups
// ─────────────────────────────────────────────

enum GroupType {
  PUBLIC
  PRIVATE
  SECRET
}

enum GroupMemberRole {
  ADMIN
  MODERATOR
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

model Group {
  id           String      @id @default(uuid())
  name         String
  description  String?     @db.Text
  coverPhoto   String?
  type         GroupType   @default(PUBLIC)

  createdById  String
  createdBy    User        @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)

  membersCount Int         @default(0)
  postsCount   Int         @default(0)

  // Who can post: true = only admins/mods, false = all members
  restrictPosting Boolean  @default(false)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  members      GroupMember[]
  joinRequests GroupJoinRequest[]
  rules        GroupRule[]
  groupPosts   GroupPost[]
  groupEvents  GroupEvent[]

  @@index([createdById])
  @@index([type, createdAt])
  @@index([deletedAt])
}

model GroupMember {
  id            String          @id @default(uuid())
  groupId       String
  group         Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          GroupMemberRole @default(MEMBER)
  acceptedRulesAt DateTime?
  joinedAt      DateTime        @default(now())
  isMuted       Boolean         @default(false)

  @@unique([groupId, userId])
  @@index([groupId, role])
  @@index([userId])
}

model GroupJoinRequest {
  id        String            @id @default(uuid())
  groupId   String
  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    JoinRequestStatus @default(PENDING)
  message   String?           @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([groupId, userId])
  @@index([groupId, status])
  @@index([userId])
}

model GroupRule {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([groupId, order])
}

model GroupPost {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  isApproved Boolean @default(true) // false = pending approval (when restrictPosting=true)
  createdAt DateTime @default(now())

  @@unique([groupId, postId])
  @@index([groupId, isApproved, createdAt])
}

// ─────────────────────────────────────────────
// Sprint 14: Pages
// ─────────────────────────────────────────────

enum PageCategory {
  BUSINESS
  BRAND
  ARTIST
  COMMUNITY
  PUBLIC_FIGURE
  OTHER
}

enum PageRole {
  ADMIN
  EDITOR
  MODERATOR
}

model Page {
  id             String      @id @default(uuid())
  name           String
  description    String?     @db.Text
  category       PageCategory @default(OTHER)
  coverPhoto     String?
  logoUrl        String?
  website        String?
  phone          String?
  isVerified     Boolean     @default(false)
  followersCount Int         @default(0)

  createdById    String
  createdBy      User        @relation("PageCreator", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  members        PageMember[]
  pagePosts      PagePost[]
  pageFollows    PageFollow[]

  @@index([createdById])
  @@index([category])
  @@index([isVerified])
  @@index([deletedAt])
}

model PageMember {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      PageRole @default(EDITOR)
  joinedAt  DateTime @default(now())

  @@unique([pageId, userId])
  @@index([pageId, role])
  @@index([userId])
}

model PageFollow {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([pageId, userId])
  @@index([pageId])
  @@index([userId])
}

model PagePost {
  id        String   @id @default(uuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([pageId, postId])
  @@index([pageId, createdAt])
}

// ─────────────────────────────────────────────
// Sprint 18: Live Streaming
// ─────────────────────────────────────────────

enum StreamStatus {
  IDLE
  LIVE
  ENDED
}

model LiveStream {
  id            String       @id @default(uuid())
  hostId        String
  host          User         @relation("StreamHost", fields: [hostId], references: [id], onDelete: Cascade)
  title         String
  description   String?      @db.Text
  thumbnailUrl  String?
  streamKey     String       @unique @default(uuid()) // opaque RTMP key
  status        StreamStatus @default(IDLE)
  viewerCount   Int          @default(0)
  peakViewers   Int          @default(0)
  isRecorded    Boolean      @default(true)
  recordingUrl  String?      // set after stream ends
  startedAt     DateTime?
  endedAt       DateTime?

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([hostId, status])
  @@index([status, startedAt])
  @@index([streamKey])
}

// ─────────────────────────────────────────────
// Sprint 19: Analytics Event Ingestion
// ─────────────────────────────────────────────

enum AnalyticsEventType {
  VIEW_POST
  LIKE_POST
  COMMENT_POST
  SHARE_POST
  VIEW_REEL
  LIKE_REEL
  VIEW_PROFILE
  VIEW_EVENT
  VIEW_GROUP
  VIEW_PAGE
  VIEW_STORY
  SEARCH
  JOIN_GROUP
  RSVP_EVENT
  FOLLOW_USER
  FOLLOW_PAGE
}

model AnalyticsEvent {
  id         String             @id @default(uuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType  AnalyticsEventType
  targetId   String?            // postId, reelId, eventId, groupId, pageId, userId, etc.
  targetType String?            // 'POST' | 'REEL' | 'EVENT' | 'GROUP' | 'PAGE' | 'USER' | 'STORY'
  metadata   Json?              // any additional context (search query, watchPct, etc.)
  sessionId  String?
  createdAt  DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([targetId, targetType])
  @@index([sessionId])
}

// ─────────────────────────────────────────────
// Sprint 20: Events & Advanced Groups
// ─────────────────────────────────────────────

enum EventType {
  ONLINE
  OFFLINE
}

enum RSVPStatus {
  GOING
  INTERESTED
  NOT_GOING
}

enum EventTicketStatus {
  ACTIVE
  USED
  CANCELLED
  PENDING_PAYMENT
}

model Event {
  id               String      @id @default(uuid())
  title            String
  description      String?     @db.Text
  coverPhoto       String?
  hostId           String
  host             User        @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)
  eventType        EventType   @default(OFFLINE)
  startTime        DateTime
  endTime          DateTime?
  location         String?     // physical address for OFFLINE events
  onlineMeetingUrl String?     // link for ONLINE events
  isPublic         Boolean     @default(true)
  maxAttendees     Int?        // null = unlimited
  attendeeCount    Int         @default(0)
  ticketPrice      Float?      // null = free event
  currency         String      @default("USD")

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  attendees        EventAttendee[]
  tickets          EventTicket[]
  reminders        EventReminder[]
  groupEvents      GroupEvent[]

  @@index([hostId, createdAt])
  @@index([startTime, isPublic])
  @@index([eventType, startTime])
  @@index([deletedAt])
}

model EventAttendee {
  id         String     @id @default(uuid())
  eventId    String
  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rsvpStatus RSVPStatus @default(INTERESTED)
  rsvpAt     DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([eventId, userId])
  @@index([eventId, rsvpStatus])
  @@index([userId, rsvpAt])
}

model EventTicket {
  id          String            @id @default(uuid())
  eventId     String
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticketCode  String            @unique @default(uuid())
  status      EventTicketStatus @default(ACTIVE)
  paidAmount  Float             @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([ticketCode])
}

model EventReminder {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  remindAt   DateTime // scheduled reminder time
  sent       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([eventId, userId])
  @@index([remindAt, sent])
}

model GroupEvent {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  linkedAt  DateTime @default(now())
  linkedById String?

  @@unique([groupId, eventId])
  @@index([groupId, linkedAt])
  @@index([eventId])
}
